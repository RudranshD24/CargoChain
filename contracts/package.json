{
  "name": "cargochain-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "CargoChain smart contracts — Solidity 0.8.24, Hardhat, local Ganache",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network ganache",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "hardhat": "^2.22.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.0"
  },
  "allowScripts": {
    "keccak@3.0.4": true,
    "secp256k1@4.0.5": true
  }
}
