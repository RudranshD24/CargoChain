# CargoChain — Local Development Environment
# Copy to .env and fill in values. NEVER commit .env or real secrets.

# --- Ganache / Local Chain ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337

# --- PostgreSQL ---
POSTGRES_USER=cargochain
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_DB=cargochain
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cargochain:CHANGE_ME_local_only@localhost:5432/cargochain

# --- IPFS (local Kubo) ---
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# --- Backend / FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=CHANGE_ME_generate_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
MAX_UPLOAD_MB=10

# --- Oracle Service ---
ORACLE_PORT=8100
ORACLE_PRIVATE_KEY=PASTE_GANACHE_TEST_ACCOUNT_PRIVATE_KEY_ONLY

# --- Deployment ---
DEPLOYMENT_FILE=deployments/local.json

# --- Frontend (public vars only — no secrets here) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CHAIN_ID=1337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
